#!/usr/bin/env bash
set -euo pipefail

devcontainer_dir="$(cd "$(dirname "$0")" && pwd)"
repository_root="$(cd "$devcontainer_dir/.." && pwd)"
cd "$repository_root"

# shellcheck disable=SC1091
source "$devcontainer_dir/agent-versions.env"

if [[ "$(id -u)" == "0" ]]; then
  echo "Agent setup must run as the non-root devcontainer user." >&2
  exit 1
fi

export NPM_CONFIG_CACHE="${NPM_CONFIG_CACHE:-$HOME/.cache/npm}"
shared_path_prefix="$repository_root/bin:$HOME/.local/bin:"
container_path="$PATH"
while [[ "$container_path" == "$shared_path_prefix"* ]]; do
  container_path="${container_path#"$shared_path_prefix"}"
done
export PATH="$shared_path_prefix$container_path"

if [[ -x /usr/sbin/sshd && -f /etc/environment ]]; then
  environment_snapshot="$(mktemp)"
  SHARED_PATH="$PATH" node -e '
    const fs = require("node:fs");
    const source = fs.readFileSync("/etc/environment", "utf8");
    const pathLine = `PATH=${JSON.stringify(process.env.SHARED_PATH)}`;
    const lines = source.split("\n").filter((line) => !line.startsWith("PATH="));
    lines.splice(lines.at(-1) === "" ? -1 : lines.length, 0, pathLine);
    process.stdout.write(lines.join("\n"));
  ' >"$environment_snapshot"
  sudo install -o root -g root -m 0644 "$environment_snapshot" /etc/environment
  rm "$environment_snapshot"
fi

skills_cache_root="$HOME/.cache/firstdraft/skills"
claude_skills_root="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
codex_skills_root="$HOME/.agents/skills"
mkdir -p \
  "$claude_skills_root" \
  "$codex_skills_root" \
  "$skills_cache_root" \
  "$NPM_CONFIG_CACHE" \
  "$HOME/.local"

firstdraft_environment="$repository_root/.env"
if [[ ! -e "$firstdraft_environment" && ! -L "$firstdraft_environment" ]]; then
  install -m 600 "$repository_root/.env.example" "$firstdraft_environment"
fi
if [[ -L "$firstdraft_environment" || ! -f "$firstdraft_environment" || \
  ! -O "$firstdraft_environment" ]]; then
  echo ".env must be a regular file owned by the devcontainer user." >&2
  exit 1
fi

if firstdraft_environment_mode="$(stat -c '%a' "$firstdraft_environment" 2>/dev/null)"; then
  :
elif firstdraft_environment_mode="$(stat -f '%Lp' "$firstdraft_environment" 2>/dev/null)"; then
  :
else
  echo "Could not inspect .env permissions." >&2
  exit 1
fi
if [[ "$firstdraft_environment_mode" != "600" ]]; then
  echo ".env must have mode 0600; run: chmod 600 .env" >&2
  exit 1
fi

npm install --global --prefix "$HOME/.local" \
  "@firstdraft.com/cli@$FIRSTDRAFT_CLI_VERSION"

# Omitting a channel preserves user settings; a fresh installation defaults to latest.
curl -fsSL https://claude.ai/install.sh | bash
curl -fsSL https://chatgpt.com/codex/install.sh | \
  CODEX_NON_INTERACTIVE=1 sh -s -- --release "$CODEX_VERSION"

skills_checkout="$skills_cache_root/$FIRSTDRAFT_SKILLS_REVISION"

if [[ ! -d "$skills_checkout/.git" ]]; then
  if [[ -e "$skills_checkout" ]]; then
    echo "Incomplete First Draft Skill cache at $skills_checkout; preserve it for inspection." >&2
    exit 1
  fi

  temporary_checkout="$(mktemp -d "$skills_cache_root/.checkout.XXXXXX")"
  git -C "$temporary_checkout" init --quiet
  git -C "$temporary_checkout" remote add origin https://github.com/firstdraft/skills.git
  git -C "$temporary_checkout" fetch --quiet --depth=1 origin "$FIRSTDRAFT_SKILLS_REVISION"
  git -C "$temporary_checkout" checkout --quiet --detach FETCH_HEAD
  mv "$temporary_checkout" "$skills_checkout"
fi

node "$devcontainer_dir/agent-skills.mjs" link \
  --checkout "$skills_checkout" \
  --revision "$FIRSTDRAFT_SKILLS_REVISION" \
  --claude-root "$claude_skills_root" \
  --codex-root "$codex_skills_root" \
  --claude-authoring-name "$FIRSTDRAFT_CLAUDE_SKILL_NAME" \
  --codex-authoring-name "$FIRSTDRAFT_CODEX_SKILL_NAME"

node "$devcontainer_dir/configure-codex.mjs"

claude --version
codex --version
firstdraft --version

printf '\nDrawing Board setup complete.\n'
printf 'Next: paste your staging First Draft token into the `FIRSTDRAFT_API_TOKEN` entry in `.env`.\n'
printf 'Then run `claude` or `codex` and describe the app you want.\n'
printf 'The internal-alpha path is `--output .`: approve moving this Drawing Board into `design/`, then continue in the app at the root.\n'
printf 'Keep the same Git repository; never run the nested application initializer after root adoption.\n'
printf 'After root Compile, ask to "Create GitHub repository" to save this workspace privately (README step 6).\n'
printf 'Choose "Compile and publish through First Draft" only for the separate Publication mode.\n'
