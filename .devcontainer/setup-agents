#!/usr/bin/env bash
set -euo pipefail

devcontainer_dir="$(cd "$(dirname "$0")" && pwd)"
repository_root="$(cd "$devcontainer_dir/.." && pwd)"
cd "$repository_root"

# shellcheck disable=SC1091
source "$devcontainer_dir/agent-versions.env"

if [[ "$(id -u)" == "0" ]]; then
  echo "Agent setup must run as the non-root devcontainer user." >&2
  exit 1
fi

export NPM_CONFIG_CACHE="${NPM_CONFIG_CACHE:-$HOME/.cache/npm}"
shared_path_prefix="$repository_root/bin:$HOME/.local/bin:"
container_path="$PATH"
while [[ "$container_path" == "$shared_path_prefix"* ]]; do
  container_path="${container_path#"$shared_path_prefix"}"
done
export PATH="$shared_path_prefix$container_path"

if [[ -x /usr/sbin/sshd && -f /etc/environment ]]; then
  environment_snapshot="$(mktemp)"
  SHARED_PATH="$PATH" node -e '
    const fs = require("node:fs");
    const source = fs.readFileSync("/etc/environment", "utf8");
    const pathLine = `PATH=${JSON.stringify(process.env.SHARED_PATH)}`;
    const lines = source.split("\n").filter((line) => !line.startsWith("PATH="));
    lines.splice(lines.at(-1) === "" ? -1 : lines.length, 0, pathLine);
    process.stdout.write(lines.join("\n"));
  ' >"$environment_snapshot"
  sudo install -o root -g root -m 0644 "$environment_snapshot" /etc/environment
  rm "$environment_snapshot"
fi

skills_cache_root="$HOME/.cache/firstdraft/skills"
claude_skills_root="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
codex_skills_root="$HOME/.agents/skills"
mkdir -p \
  "$claude_skills_root" \
  "$codex_skills_root" \
  "$skills_cache_root" \
  "$NPM_CONFIG_CACHE" \
  "$HOME/.local"

npm install --global --prefix "$HOME/.local" \
  "@firstdraft.com/cli@$FIRSTDRAFT_CLI_VERSION"
npm install --global --prefix "$HOME/.local" "neonctl@$NEONCTL_VERSION"

case "$(uname -m)" in
  x86_64 | amd64)
    release_architecture=amd64
    render_cli_sha256="$RENDER_CLI_SHA256_AMD64"
    revyl_cli_sha256="$REVYL_CLI_SHA256_AMD64"
    ;;
  aarch64 | arm64)
    release_architecture=arm64
    render_cli_sha256="$RENDER_CLI_SHA256_ARM64"
    revyl_cli_sha256="$REVYL_CLI_SHA256_ARM64"
    ;;
  *)
    echo "No pinned Render and Revyl CLIs for the $(uname -m) architecture." >&2
    exit 1
    ;;
esac

# Downloads one pinned release asset and stops unless it matches its pinned SHA-256.
download_verified() {
  local url="$1" expected="$2" destination="$3"
  curl -fsSL -o "$destination" "$url"
  node -e '
    const [file, expected] = process.argv.slice(1);
    const actual = require("node:crypto").createHash("sha256")
      .update(require("node:fs").readFileSync(file)).digest("hex");
    if (actual !== expected) {
      console.error(`${file} has SHA-256 ${actual}, not the pinned ${expected}.`);
      process.exit(1);
    }
  ' "$destination" "$expected"
}

workshop_downloads="$(mktemp -d)"
download_verified \
  "https://github.com/render-oss/cli/releases/download/v$RENDER_CLI_VERSION/cli_${RENDER_CLI_VERSION}_linux_${release_architecture}.zip" \
  "$render_cli_sha256" "$workshop_downloads/render.zip"
unzip -q -o "$workshop_downloads/render.zip" "cli_v$RENDER_CLI_VERSION" -d "$workshop_downloads"
install -m 0755 "$workshop_downloads/cli_v$RENDER_CLI_VERSION" "$HOME/.local/bin/render"
# Revyl's own installer uses ~/.revyl/bin; the PATH link lets every shell and agent find it.
download_verified \
  "https://github.com/RevylAI/revyl-cli/releases/download/v$REVYL_CLI_VERSION/revyl-linux-$release_architecture" \
  "$revyl_cli_sha256" "$workshop_downloads/revyl"
mkdir -p "$HOME/.revyl/bin"
install -m 0755 "$workshop_downloads/revyl" "$HOME/.revyl/bin/revyl"
ln -sfn "$HOME/.revyl/bin/revyl" "$HOME/.local/bin/revyl"
rm -rf "$workshop_downloads"

# Omitting a channel preserves user settings; a fresh installation defaults to latest.
curl -fsSL https://claude.ai/install.sh | bash
curl -fsSL https://chatgpt.com/codex/install.sh | \
  CODEX_NON_INTERACTIVE=1 sh -s -- --release "$CODEX_VERSION"

skills_checkout="$skills_cache_root/$FIRSTDRAFT_SKILLS_REVISION"

if [[ ! -d "$skills_checkout/.git" ]]; then
  if [[ -e "$skills_checkout" ]]; then
    echo "Incomplete First Draft Skill cache at $skills_checkout; preserve it for inspection." >&2
    exit 1
  fi

  temporary_checkout="$(mktemp -d "$skills_cache_root/.checkout.XXXXXX")"
  git -C "$temporary_checkout" init --quiet
  git -C "$temporary_checkout" remote add origin https://github.com/firstdraft/skills.git
  git -C "$temporary_checkout" fetch --quiet --depth=1 origin "$FIRSTDRAFT_SKILLS_REVISION"
  git -C "$temporary_checkout" checkout --quiet --detach FETCH_HEAD
  mv "$temporary_checkout" "$skills_checkout"
fi

node "$devcontainer_dir/agent-skills.mjs" link \
  --checkout "$skills_checkout" \
  --revision "$FIRSTDRAFT_SKILLS_REVISION" \
  --claude-root "$claude_skills_root" \
  --codex-root "$codex_skills_root" \
  --claude-authoring-name "$FIRSTDRAFT_CLAUDE_SKILL_NAME" \
  --codex-authoring-name "$FIRSTDRAFT_CODEX_SKILL_NAME"

node "$devcontainer_dir/configure-codex.mjs"

# The laptop kit's sign-in helpers, sign-in Skill and app-session notes. Helpers and notes are
# copied, not linked: root Compile moves this Drawing Board under .firstdraft/design/.
workshop_source="$devcontainer_dir/workshop"
install -d -m 0700 "$HOME/.workshop"
for helper in auth.sh cloudinary.sh git-identity.sh login.sh neon-key.sh open.sh render-workspace.sh; do
  install -m 0755 "$workshop_source/$helper" "$HOME/.workshop/$helper"
done
for skills_root in "$claude_skills_root" "$codex_skills_root"; do
  mkdir -p "$skills_root/workshop-signin"
  install -m 0644 "$workshop_source/skills/workshop-signin/SKILL.md" \
    "$skills_root/workshop-signin/SKILL.md"
done
# Every Claude and Codex session loads these user-level files, before and after root Compile.
node "$devcontainer_dir/workshop-notes.mjs" "$workshop_source/app-instructions.md" \
  "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md" \
  "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"

claude --version
codex --version
firstdraft --version
render --version
neonctl --version
revyl --version

printf '\nDrawing Board setup complete.\n'
printf 'Next: run `claude` (or `codex`) and sign in, then type /workshop-signin (README Part 2).\n'
printf 'Then start building with README Part 3.\n'
