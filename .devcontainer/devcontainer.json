{
  "name": "First Draft Drawing Board",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CODEX_HOME": "/home/node/.codex",
    "NPM_CONFIG_CACHE": "/home/node/.cache/npm",
    "DISABLE_AUTOUPDATER": "1"
  },
  "remoteEnv": {
    "PATH": "/home/node/.local/bin:${containerEnv:PATH}"
  },
  "mounts": [
    "source=firstdraft-drawing-board-claude-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=firstdraft-drawing-board-codex-${devcontainerId},target=/home/node/.codex,type=volume",
    "source=firstdraft-drawing-board-cache-${devcontainerId},target=/home/node/.cache,type=volume"
  ],
  "onCreateCommand": "sudo chown -R node:node /home/node/.claude /home/node/.codex /home/node/.cache",
  "postCreateCommand": ".devcontainer/setup-agents"
}
