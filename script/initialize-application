#!/usr/bin/env bash
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
application_root="${root}/application"

for required_path in \
  bin/setup \
  bin/ci \
  .firstdraft/submitted-foundation-plan.json \
  .firstdraft/gaps.json; do
  if [[ ! -e "${application_root}/${required_path}" ]]; then
    echo "Expected generated application file: application/${required_path}" >&2
    exit 1
  fi
done

if [[ -e "${application_root}/.git" ]]; then
  echo "The generated application already has its own Git repository." >&2
  exit 1
fi

configured_name="$(git config --get user.name || true)"
configured_email="$(git config --get user.email || true)"
author_name="${GIT_AUTHOR_NAME:-${configured_name:-${GITHUB_USER:-}}}"
author_email="${GIT_AUTHOR_EMAIL:-${configured_email:-${GIT_COMMITTER_EMAIL:-}}}"
if [[ -z "${author_name}" || -z "${author_email}" ]]; then
  echo "Configure your Git name and email before initializing the application." >&2
  exit 1
fi

temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/drawing-board-application-init.XXXXXX")"
cleanup() {
  rm -rf -- "${temporary_root}"
}
trap cleanup EXIT

temporary_checkout="${temporary_root}/repository"
git init --quiet --initial-branch=main "${temporary_checkout}"
temporary_git_dir="${temporary_checkout}/.git"

git_with_application() {
  GIT_DIR="${temporary_git_dir}" GIT_WORK_TREE="${application_root}" git "$@"
}

git_with_application add --all
git_with_application diff --cached --check
GIT_AUTHOR_NAME="${author_name}" \
  GIT_AUTHOR_EMAIL="${author_email}" \
  GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-${author_name}}" \
  GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-${author_email}}" \
  GIT_DIR="${temporary_git_dir}" \
  GIT_WORK_TREE="${application_root}" \
  git -c commit.gpgsign=false commit --quiet --message "Start generated application"

initial_commit="$(git_with_application rev-parse HEAD)"
if [[ "$(git_with_application rev-list --parents --max-count=1 HEAD | wc -w | tr -d ' ')" != "1" ]]; then
  echo "The generated application must start with one parentless commit." >&2
  exit 1
fi
if [[ -n "$(git_with_application status --porcelain)" ]]; then
  echo "The generated application repository did not initialize cleanly." >&2
  exit 1
fi

mv "${temporary_git_dir}" "${application_root}/.git"
rmdir "${temporary_checkout}"
rmdir "${temporary_root}"
trap - EXIT

echo "Initialized application at ${initial_commit} on main."
