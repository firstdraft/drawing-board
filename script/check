#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Keep these shared configurations in strict JSON, a machine-checkable subset
# of the JSONC accepted by the devcontainer reader.
node -e 'JSON.parse(require("node:fs").readFileSync(".devcontainer/devcontainer.json", "utf8"))'

# shellcheck disable=SC1091
source .devcontainer/agent-versions.env

for script in .devcontainer/setup-agents bin/agent-doctor bin/review-plan-with-claude bin/review-plan-with-codex script/check script/devcontainer-smoke; do
  bash -n "$script"
  if [[ ! -x "$script" ]]; then
    echo "$script must be executable." >&2
    exit 1
  fi
done

if [[ "$FIRSTDRAFT_CLI_DEFAULT_API_URL" != "https://firstdraft.com" || \
  "$FIRSTDRAFT_CLAUDE_PLUGIN_DEFAULT_API_URL" != "https://staging.firstdraft.com" ]]; then
  echo "The standalone and Claude plugin origins must match the documented qualification contract." >&2
  exit 1
fi

set +e
grep -En '(^|[^A-Z_])FIRSTDRAFT_API_URL([[:space:]]*=|[[:space:]]*":)' \
  .devcontainer/devcontainer.json .devcontainer/setup-agents
configured_origin_status=$?
set -e
case "$configured_origin_status" in
  0)
    echo "The devcontainer must not export a First Draft origin; users select it before their first push." >&2
    exit 1
    ;;
  1) ;;
  *)
    echo "The configured-origin check could not inspect its inputs." >&2
    exit 1
    ;;
esac

if [[ -e .claude/settings.json ]]; then
  echo "Claude plugin installation is owned by setup-agents, not project settings." >&2
  exit 1
fi

claude_marketplace_name="${FIRSTDRAFT_CLAUDE_PLUGIN_ID#*@}"
if [[ -z "$claude_marketplace_name" || "$claude_marketplace_name" == "$FIRSTDRAFT_CLAUDE_PLUGIN_ID" ]]; then
  echo "The configured Claude plugin ID must include its marketplace." >&2
  exit 1
fi

if [[ ! "$FIRSTDRAFT_SKILLS_REVISION" =~ ^[0-9a-f]{40}$ ]]; then
  echo "The First Draft Skill revision must be one exact commit SHA." >&2
  exit 1
fi

for version in \
  "$FIRSTDRAFT_CLI_VERSION" \
  "$FIRSTDRAFT_CLAUDE_PLUGIN_VERSION" \
  "$FIRSTDRAFT_CLAUDE_PLUGIN_CLI_VERSION"; do
  if [[ ! "$version" =~ ^0\.[0-9]+\.[0-9]+$ ]]; then
    echo "First Draft release versions must use ordinary pre-1.0 SemVer." >&2
    exit 1
  fi
done

if [[ "$FIRSTDRAFT_CLAUDE_PLUGIN_ID" != "firstdraft@$claude_marketplace_name" ]]; then
  echo "The configured Claude plugin ID must use the First Draft marketplace name." >&2
  exit 1
fi

set +e
git grep --untracked -IEn '(fd_[A-Za-z0-9_-]{20,}|FIRSTDRAFT_API_TOKEN=.+|gh[opsu]_[A-Za-z0-9]{20,})' \
  -- . ':(exclude)script/check'
credential_status=$?
set -e
case "$credential_status" in
  0)
    echo "A credential-like value was found in the repository." >&2
    exit 1
    ;;
  1) ;;
  *)
    echo "The credential scan could not inspect the repository." >&2
    exit 1
    ;;
esac

echo "Drawing Board contract checks passed."
