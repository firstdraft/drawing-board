#!/usr/bin/env bash
# shellcheck disable=SC2016
set -euo pipefail

cd "$(dirname "$0")/.."

# shellcheck disable=SC1091
source .devcontainer/agent-versions.env

assert_version() {
  local expected="$1"
  shift
  local output
  if ! output="$("$@" 2>&1)"; then
    echo "$* failed while checking expected version $expected." >&2
    exit 1
  fi
  local normalized_output
  normalized_output="$(printf '%s' "$output" | tr '[:space:]' ' ' | tr -s ' ')"
  if [[ " $normalized_output " != *" $expected "* ]]; then
    echo "Expected $expected from $*, found: $output" >&2
    exit 1
  fi
}

assert_version "$CLAUDE_CODE_VERSION" claude --version
assert_version "$CODEX_VERSION" codex --version
assert_version "$FIRSTDRAFT_CLI_VERSION" firstdraft --version

bin/agent-doctor --installation-only
claude --effort high --permission-mode plan --allowed-tools "Read,Glob,Grep,Skill" --version >/dev/null
codex --sandbox read-only --ask-for-approval never exec --help >/dev/null

# shellcheck disable=SC2016
plugin_record="$(claude plugin list --json | \
  FIRSTDRAFT_CLAUDE_PLUGIN_ID="$FIRSTDRAFT_CLAUDE_PLUGIN_ID" node -e '
    const parsed = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
    const plugins = Array.isArray(parsed) ? parsed : parsed.plugins;
    if (!Array.isArray(plugins)) process.exit(2);
    const plugin = plugins.find(({ id, scope }) =>
      id === process.env.FIRSTDRAFT_CLAUDE_PLUGIN_ID && scope === "local",
    );
    if (!plugin) process.exit(1);
    process.stdout.write(`${plugin.version}\t${plugin.scope}\t${plugin.enabled}\t${plugin.installPath}`);
  ')"
IFS=$'\t' read -r plugin_version plugin_scope plugin_enabled plugin_install_path <<<"$plugin_record"
test "$plugin_version" = "$FIRSTDRAFT_CLAUDE_PLUGIN_VERSION"
test "$plugin_scope" = "local"
test "$plugin_enabled" = "true"
test -d "$plugin_install_path"

marketplace_name="${FIRSTDRAFT_CLAUDE_PLUGIN_ID#*@}"
# shellcheck disable=SC2016
marketplace_record="$(claude plugin marketplace list --json | \
  FIRSTDRAFT_CLAUDE_MARKETPLACE="$marketplace_name" node -e '
    const marketplaces = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
    if (!Array.isArray(marketplaces)) process.exit(2);
    const marketplace = marketplaces.find(({ name }) =>
      name === process.env.FIRSTDRAFT_CLAUDE_MARKETPLACE,
    );
    if (!marketplace) process.exit(1);
    process.stdout.write(`${marketplace.source}\t${marketplace.path}`);
  ')"
IFS=$'\t' read -r marketplace_source marketplace_path <<<"$marketplace_record"
test "$marketplace_source" = "directory"
test "$(git -C "$marketplace_path" rev-parse HEAD)" = "$FIRSTDRAFT_SKILLS_REVISION"

claude plugin list --available --json | node -e '
    const parsed = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
    const valid = !Array.isArray(parsed) &&
      Array.isArray(parsed.installed) &&
      Array.isArray(parsed.available);
    process.exit(valid ? 0 : 1);
  '

# shellcheck disable=SC2016
FIRSTDRAFT_CLAUDE_PLUGIN_VERSION="$FIRSTDRAFT_CLAUDE_PLUGIN_VERSION" \
  FIRSTDRAFT_CLAUDE_PLUGIN_DEFAULT_API_URL="$FIRSTDRAFT_CLAUDE_PLUGIN_DEFAULT_API_URL" \
  FIRSTDRAFT_CLAUDE_PLUGIN_PATH="$plugin_install_path" \
  node -e '
    const path = require("node:path");
    const manifest = require(path.join(
      process.env.FIRSTDRAFT_CLAUDE_PLUGIN_PATH,
      ".claude-plugin",
      "plugin.json",
    ));
    const options = manifest.userConfig ?? {};
    const valid = manifest.version === process.env.FIRSTDRAFT_CLAUDE_PLUGIN_VERSION &&
      Object.keys(options).sort().join(",") === "api_token,api_url" &&
      options.api_url.required === true &&
      options.api_url.default === process.env.FIRSTDRAFT_CLAUDE_PLUGIN_DEFAULT_API_URL &&
      options.api_token.required === true &&
      options.api_token.sensitive === true;
    process.exit(valid ? 0 : 1);
  '
assert_version "$FIRSTDRAFT_CLAUDE_PLUGIN_CLI_VERSION" \
  "$plugin_install_path/bin/firstdraft" --version

claude_user_settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
FIRSTDRAFT_CLAUDE_PLUGIN_ID="$FIRSTDRAFT_CLAUDE_PLUGIN_ID" \
  FIRSTDRAFT_CLAUDE_PLUGIN_DEFAULT_API_URL="$FIRSTDRAFT_CLAUDE_PLUGIN_DEFAULT_API_URL" \
  node -e '
    const settings = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
    const options = settings.pluginConfigs?.[process.env.FIRSTDRAFT_CLAUDE_PLUGIN_ID]?.options;
    const valid = options?.api_url === process.env.FIRSTDRAFT_CLAUDE_PLUGIN_DEFAULT_API_URL &&
      !Object.prototype.hasOwnProperty.call(options, "api_token");
    process.exit(valid ? 0 : 1);
  ' "$claude_user_settings"

skill_path="$HOME/.agents/skills/create-full-stack-app"
test -r "$skill_path/SKILL.md"
test "$(git -C "$skill_path" rev-parse HEAD)" = "$FIRSTDRAFT_SKILLS_REVISION"

prompt_input="$(codex debug prompt-input "Use the create-full-stack-app Skill.")"
skill_target="$(cd "$skill_path" && pwd -P)/SKILL.md"
CODEX_SKILL_NAME="$FIRSTDRAFT_CODEX_SKILL_NAME" \
  CODEX_SKILL_LINK="$skill_path/SKILL.md" \
  CODEX_SKILL_TARGET="$skill_target" \
  node -e '
  const input = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
  const textBlocks = input.flatMap((item) => item.content ?? [])
    .filter((content) => content.type === "input_text")
    .map((content) => content.text);
  const skillInventory = textBlocks.find((text) => text.includes("<skills_instructions>"));
  const expectedPaths = [process.env.CODEX_SKILL_LINK, process.env.CODEX_SKILL_TARGET];
  const skillLines = skillInventory?.split("\n").filter((line) =>
    line.startsWith(`- ${process.env.CODEX_SKILL_NAME}:`),
  ) ?? [];
  const discovered = skillLines.length === 1 && expectedPaths.some((path) =>
    skillLines[0].endsWith(`(file: ${path})`),
  );
  process.exit(discovered ? 0 : 1);
' <<<"$prompt_input"

echo "Devcontainer installation smoke passed."
