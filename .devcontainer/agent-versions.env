# Codex public release selector; Claude's native installer defaults to latest.
# Record installed agent versions in qualification receipts.
CODEX_VERSION=latest
# First Draft compatibility pins are independent of the agents' update policy.
FIRSTDRAFT_CLI_VERSION=0.8.2
# CLI 0.8.x uses First Draft API 0.7.x and defaults to local root output.
# The wrapper selects this production origin; `firstdraft login --device` saves its login.
FIRSTDRAFT_CLI_DEFAULT_API_URL=https://firstdraft.com
# Shared Claude/Codex authoring Skill; exact source of plugin 0.8.7 (tag claude-v0.8.7; CLI 0.8.2, API 0.7).
FIRSTDRAFT_SKILLS_REVISION=52a10d495eaadc76064b390057e5ee9463574f25
FIRSTDRAFT_CLAUDE_SKILL_NAME=create-full-stack-app
# Codex namespaces the canonical source checkout with its root plugin manifest.
FIRSTDRAFT_CODEX_SKILL_NAME=firstdraft:create-full-stack-app

# Deploy and native-preview CLIs from the laptop kit's command-line path. Each digest is the
# release's published SHA-256 for its Linux asset.
RENDER_CLI_VERSION=2.28.0
RENDER_CLI_SHA256_AMD64=00d1ca6f3c31b1f4bc7316837b8ee24acbeb11cf372b7593c7d2c3106a1987b4
RENDER_CLI_SHA256_ARM64=aa4a3070fefe2aaaaa87f7bfa21674ea6d63df0ebadbfafd974bdc7216d72271
NEONCTL_VERSION=8.0.8
REVYL_CLI_VERSION=0.1.133
REVYL_CLI_SHA256_AMD64=032c52c8ee9ae0ec9ba085e4e7391ac17638eccdc7624fd9ab01dc2e44be5665
REVYL_CLI_SHA256_ARM64=869b891c0cd29cbcbdd005335a6af9db0db91562b7f201f46487e77e1d53f9d8

# Keep the shared Codespace ready for current generated Foundations.
FOUNDATION_RUBY_VERSION=4.0.5
FOUNDATION_NODE_VERSION=24.18.0
FOUNDATION_POSTGRES_VERSION=18
