#!/usr/bin/env bash
set -Eeuo pipefail

root="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

# Git plumbing variables belong to the repository that exported them. They may
# not redirect this initializer's temporary repository, index, or object store.
unset GIT_DIR \
  GIT_WORK_TREE \
  GIT_INDEX_FILE \
  GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_COMMON_DIR \
  GIT_NAMESPACE

if (( $# > 1 )); then
  echo "Usage: script/initialize-application [APPLICATION_PATH]" >&2
  exit 1
fi

application_argument="${1:-application}"
if [[ -z "${application_argument}" ]]; then
  echo "The application path must not be empty." >&2
  exit 1
fi
if [[ "${application_argument}" = /* ]]; then
  application_candidate="${application_argument}"
else
  application_candidate="${root}/${application_argument}"
fi
if [[ ! -d "${application_candidate}" ]]; then
  echo "Expected a generated application directory at ${application_argument}." >&2
  exit 1
fi

application_root="$(cd -P "${application_candidate}" && pwd -P)"
case "${application_root}" in
  "${root}"/*) ;;
  *)
    echo "The generated application must resolve inside the Drawing Board." >&2
    exit 1
    ;;
esac

for required_path in \
  bin/setup \
  bin/ci \
  .firstdraft/submitted-foundation-plan.json \
  .firstdraft/gaps.json; do
  if [[ ! -f "${application_root}/${required_path}" || -L "${application_root}/${required_path}" ]]; then
    echo "Expected generated application file: application/${required_path}" >&2
    exit 1
  fi
done
if [[ ! -x "${application_root}/bin/setup" || ! -x "${application_root}/bin/ci" ]]; then
  echo "Expected executable generated application setup and CI commands." >&2
  exit 1
fi

if [[ -e "${application_root}/.git" || -L "${application_root}/.git" ]]; then
  echo "The generated application already has its own Git repository." >&2
  exit 1
fi

configured_name="$(git config --get user.name || true)"
configured_email="$(git config --get user.email || true)"
author_name="${GIT_AUTHOR_NAME:-${configured_name:-${GITHUB_USER:-}}}"
author_email="${GIT_AUTHOR_EMAIL:-${configured_email:-${GIT_COMMITTER_EMAIL:-}}}"
if [[ -z "${author_name}" || -z "${author_email}" ]]; then
  echo "Configure your Git name and email before initializing the application." >&2
  exit 1
fi

temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/drawing-board-application-init.XXXXXX")"
cleanup() {
  rm -rf -- "${temporary_root}"
}
trap cleanup EXIT

temporary_checkout="${temporary_root}/repository"
inventory_path="${temporary_root}/source-inventory.json"
inventory_paths_path="${temporary_root}/source-paths"
expected_firstdraft_paths_path="${temporary_root}/expected-firstdraft-paths"
actual_firstdraft_paths_path="${temporary_root}/actual-firstdraft-paths"
git init --quiet --initial-branch=main "${temporary_checkout}"
temporary_git_dir="${temporary_checkout}/.git"
git --git-dir="${temporary_git_dir}" config core.autocrlf false
git --git-dir="${temporary_git_dir}" config core.fileMode true

git_with_application() {
  GIT_DIR="${temporary_git_dir}" GIT_WORK_TREE="${application_root}" \
    git -c core.autocrlf=false -c core.fileMode=true "$@"
}

git_with_application -c core.excludesFile=/dev/null add --all -- :/
git_with_application --literal-pathspecs add --force -- \
  .firstdraft/gaps.json \
  .firstdraft/submitted-foundation-plan.json

printf '%s\0' \
  .firstdraft/gaps.json \
  .firstdraft/submitted-foundation-plan.json >"${expected_firstdraft_paths_path}"
git_with_application --literal-pathspecs ls-files -z --cached -- .firstdraft \
  >"${actual_firstdraft_paths_path}"
if ! cmp -s "${expected_firstdraft_paths_path}" "${actual_firstdraft_paths_path}"; then
  echo "The generated application .firstdraft directory must contain only the submitted Plan and GapSet." >&2
  exit 1
fi

ignored_path="$(
  git_with_application -c core.excludesFile=/dev/null \
    ls-files --others --ignored --exclude-standard --directory --no-empty-directory -- :/ |
    LC_ALL=C sort |
    sed -n '1p'
)"
if [[ -n "${ignored_path}" ]]; then
  echo "Ignored local state exists at application/${ignored_path}." >&2
  echo "Move it outside the generated application or compile into a fresh absent directory; nothing was removed." >&2
  exit 1
fi

git_with_application ls-files -z --cached -- :/ >"${inventory_paths_path}"
inventory_capture="$(
  node "${root}/script/application-repository-inventory.mjs" capture \
    "${application_root}" "${inventory_path}" "${inventory_paths_path}"
)"
if [[ "${inventory_capture}" != "Application inventory captured." ]]; then
  echo "The generated application source inventory was not captured." >&2
  exit 1
fi

GIT_AUTHOR_NAME="${author_name}" \
  GIT_AUTHOR_EMAIL="${author_email}" \
  GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-${author_name}}" \
  GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-${author_email}}" \
  GIT_DIR="${temporary_git_dir}" \
  GIT_WORK_TREE="${application_root}" \
  git -c commit.gpgsign=false -c core.hooksPath=/dev/null \
    -c core.autocrlf=false -c core.fileMode=true commit --quiet --no-verify \
    --message "Start generated application"

initial_commit="$(git_with_application rev-parse HEAD)"
if [[ "$(git_with_application rev-list --parents --max-count=1 HEAD | wc -w | tr -d ' ')" != "1" ]]; then
  echo "The generated application must start with one parentless commit." >&2
  exit 1
fi
if [[ -n "$(git_with_application status --porcelain)" ]]; then
  echo "The generated application repository did not initialize cleanly." >&2
  exit 1
fi
inventory_verification="$(
  node "${root}/script/application-repository-inventory.mjs" verify \
    "${application_root}" "${inventory_path}" "${temporary_git_dir}"
)"
if [[ "${inventory_verification}" != "Application inventory verified." ]]; then
  echo "The generated application inventory was not verified." >&2
  exit 1
fi

mv "${temporary_git_dir}" "${application_root}/.git"
committed_root="$(git -C "${application_root}" rev-parse --show-toplevel)"
committed_root="$(cd -P "${committed_root}" && pwd -P)"
if [[ "${committed_root}" != "${application_root}" || \
  "$(git -C "${application_root}" branch --show-current)" != "main" || \
  "$(git -C "${application_root}" rev-parse HEAD)" != "${initial_commit}" ]]; then
  echo "The generated application repository did not resolve at its physical root on main." >&2
  exit 1
fi
rm -f -- \
  "${inventory_path}" \
  "${inventory_paths_path}" \
  "${expected_firstdraft_paths_path}" \
  "${actual_firstdraft_paths_path}"
rmdir "${temporary_checkout}" "${temporary_root}"
trap - EXIT

echo "Initialized application at ${initial_commit} on main."
