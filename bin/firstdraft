#!/usr/bin/env node

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const {spawn, spawnSync} = require("node:child_process");
const {parseEnv} = require("node:util");

const repositoryRoot = path.resolve(__dirname, "..");

function expectedConfiguration(root = repositoryRoot) {
  const versions = parseEnv(fs.readFileSync(
    path.join(root, ".devcontainer", "agent-versions.env"),
    "utf8",
  ));
  return {
    cliVersion: versions.FIRSTDRAFT_CLI_VERSION,
    apiUrl: versions.FIRSTDRAFT_CLI_DEFAULT_API_URL,
  };
}

// The CLI's own credentials path: an absolute XDG_CONFIG_HOME, otherwise ~/.config.
function credentialsPath(environment = process.env) {
  const configHome = environment.XDG_CONFIG_HOME;
  const base = configHome && path.isAbsolute(configHome) ?
    configHome :
    path.join(environment.HOME ?? os.homedir(), ".config");
  return path.join(base, "firstdraft", "credentials.json");
}

// Reports whether `firstdraft login` saved a token for the origin, without returning the token.
function hasSavedLogin(apiUrl, environment = process.env) {
  let source;
  try {
    source = fs.readFileSync(credentialsPath(environment), "utf8");
  } catch (error) {
    if (error.code === "ENOENT") return false;
    throw error;
  }
  const token = JSON.parse(source).origins?.[apiUrl]?.access_token;
  return typeof token === "string" && token.trim().length > 0;
}

// The CLI prefers an environment token to its saved login. Dropping inherited tokens keeps the
// production login saved by `firstdraft login --device` as the workspace's only First Draft credential.
function childEnvironment(environment, apiUrl) {
  const child = {...environment, FIRSTDRAFT_API_URL: apiUrl};
  delete child.FIRSTDRAFT_API_TOKEN;
  delete child.FIRSTDRAFT_STAGING_API_TOKEN;
  return child;
}

async function run({
  arguments_ = process.argv.slice(2),
  downstreamCli = path.join(process.env.HOME, ".local", "bin", "firstdraft"),
  environment = process.env,
  root = repositoryRoot,
  stdio = "inherit",
} = {}) {
  const expected = expectedConfiguration(root);

  if (!fs.existsSync(downstreamCli)) {
    throw new Error("the pinned standalone First Draft CLI is missing; rerun .devcontainer/setup-agents.");
  }

  const env = childEnvironment(environment, expected.apiUrl);
  const version = spawnSync(downstreamCli, ["--version"], {encoding: "utf8", env});
  const versionTokens = (version.stdout ?? "").trim().split(/\s+/);
  if (version.status !== 0 || version.signal || !versionTokens.includes(expected.cliVersion)) {
    throw new Error(`the standalone First Draft CLI must be exactly ${expected.cliVersion}.`);
  }

  return await new Promise((resolve, reject) => {
    const child = spawn(downstreamCli, arguments_, {env, stdio});
    child.once("error", reject);
    child.once("exit", (status, signal) => resolve({signal, status}));
  });
}

if (require.main === module) {
  run().then(({signal, status}) => {
    if (signal) {
      process.kill(process.pid, signal);
    } else {
      process.exitCode = status ?? 1;
    }
  }).catch((error) => {
    process.stderr.write(`First Draft Drawing Board: ${error.message}\n`);
    process.exitCode = 1;
  });
}

module.exports = {childEnvironment, credentialsPath, expectedConfiguration, hasSavedLogin, run};
