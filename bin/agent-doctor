#!/usr/bin/env bash
set -u

repository_root="$(cd "$(dirname "$0")/.." && pwd)" || exit 1
cd "$repository_root" || exit 1

installation_only=false
case "${1:-}" in
  "") ;;
  --installation-only) installation_only=true ;;
  *)
    echo "Usage: bin/agent-doctor [--installation-only]" >&2
    exit 2
    ;;
esac

versions_file="$repository_root/.devcontainer/agent-versions.env"
if [[ ! -r "$versions_file" ]]; then
  echo "Agent version contract is missing: $versions_file" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$versions_file"

status=0

check_version() {
  local label="$1"
  local expected="$2"
  shift 2

  local output
  if output="$("$@" 2>&1)"; then
    local normalized_output
    normalized_output="$(printf '%s' "$output" | tr '[:space:]' ' ' | tr -s ' ')"
    if [[ -n "$normalized_output" && ( "$expected" == "latest" || " $normalized_output " == *" $expected "* ) ]]; then
      printf '%-24s %s\n' "$label" "$output"
    else
      printf '%-24s version mismatch: expected %s, found %s\n' "$label" "$expected" "$output"
      status=1
    fi
  else
    local normalized_output
    normalized_output="$(printf '%s' "$output" | tr '[:space:]' ' ' | tr -s ' ')"
    printf '%-24s unavailable%s\n' \
      "$label" "${normalized_output:+: $normalized_output}"
    status=1
  fi
}

check_workspace_cli() {
  local expected="$repository_root/bin/firstdraft"
  local resolved
  resolved="$(command -v firstdraft 2>/dev/null || true)"
  if [[ "$resolved" == "$expected" ]]; then
    printf '%-24s %s\n' "First Draft command" "$resolved"
  else
    printf '%-24s expected %s, found %s\n' \
      "First Draft command" "$expected" "${resolved:-unavailable}"
    status=1
  fi
}

check_firstdraft_login() {
  local login_state
  if ! login_state="$(node -e '
    const {hasSavedLogin} = require(process.argv[1]);
    process.stdout.write(String(hasSavedLogin(process.argv[2])));
  ' "$repository_root/bin/firstdraft" "$FIRSTDRAFT_CLI_DEFAULT_API_URL" 2>/dev/null)"; then
    printf '%-24s unreadable; run /workshop-signin again\n' "First Draft login"
    status=1
    return
  fi
  if [[ "$login_state" == "true" ]]; then
    printf '%-24s saved for %s (token not shown)\n' "First Draft login" "$FIRSTDRAFT_CLI_DEFAULT_API_URL"
  else
    printf '%-24s missing; run /workshop-signin, or: firstdraft login --device\n' "First Draft login"
    status=1
  fi
}

check_workshop_helpers() {
  local helper skill missing=""
  for helper in auth.sh cloudinary.sh git-identity.sh login.sh neon-key.sh open.sh render-workspace.sh; do
    [[ -x "$HOME/.workshop/$helper" ]] || missing="$missing $helper"
  done
  for skill in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/workshop-signin/SKILL.md" \
    "$HOME/.agents/skills/workshop-signin/SKILL.md"; do
    [[ -f "$skill" ]] || missing="$missing $skill"
  done
  if [[ -z "$missing" ]]; then
    printf '%-24s ~/.workshop and /workshop-signin\n' "Workshop sign-in"
  else
    printf '%-24s missing:%s\n' "Workshop sign-in" "$missing"
    status=1
  fi
}


check_version "Claude Code" latest claude --version
check_version "Codex" "$CODEX_VERSION" codex --version
check_version "First Draft CLI" "$FIRSTDRAFT_CLI_VERSION" \
  "$HOME/.local/bin/firstdraft" --version
check_version "Render CLI" "v$RENDER_CLI_VERSION" render --version
check_version "Neon CLI" "$NEONCTL_VERSION" neonctl --version
check_version "Revyl CLI" "v$REVYL_CLI_VERSION" revyl --version
check_workspace_cli
check_workshop_helpers
if ! node "$repository_root/.devcontainer/agent-skills.mjs" check \
  --checkout "$HOME/.cache/firstdraft/skills/$FIRSTDRAFT_SKILLS_REVISION" \
  --revision "$FIRSTDRAFT_SKILLS_REVISION" \
  --claude-root "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills" \
  --codex-root "$HOME/.agents/skills" \
  --claude-authoring-name "$FIRSTDRAFT_CLAUDE_SKILL_NAME" \
  --codex-authoring-name "$FIRSTDRAFT_CODEX_SKILL_NAME"; then
  status=1
fi

if [[ "$installation_only" == "true" ]]; then
  if claude auth status --help >/dev/null 2>&1 &&
    claude update --help >/dev/null 2>&1 &&
    codex login status --help >/dev/null 2>&1 &&
    codex update --help >/dev/null 2>&1 &&
    codex login --device-auth --help >/dev/null 2>&1 &&
    codex resume --help >/dev/null 2>&1; then
    printf '%-24s available\n' "Agent command contract"
  else
    printf '%-24s unavailable\n' "Agent command contract"
    status=1
  fi
  exit "$status"
fi

check_firstdraft_login

exit "$status"
